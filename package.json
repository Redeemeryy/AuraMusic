{
  "name": "auramusic-web",
  "private": true,
  "scripts": {
    "build:web": "tailwindcss -c tailwind.config.cjs -i web-build/input.css -o app/src/main/assets/web/utilities.css --minify",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui.cjs",
    "test:discover": "node tests/discover.cjs",
    "test:motion": "node tests/motion.cjs",
    "test:queue": "node tests/queue.cjs",
    "test:glass": "node tests/song-glass.cjs",
    "test:search-player": "node tests/search-quality-backdrop.cjs",
    "test:playlist-live": "node tests/playlist-live.cjs",
    "test:playlist-edit": "node --test tests/playlist-edit.cjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "playwright": "1.56.1"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
